# Reference only: export these in the shell or process manager; nothing loads this file.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,.localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:4201,http://*.localhost:4201
# Behind nginx or another reverse proxy: the number of proxies in front of Django.
DJANGO_PROXY_COUNT=0
# Production only (DJANGO_DEBUG=0): HTTPS redirect, HSTS and the Django admin.
DJANGO_SSL_REDIRECT=1
DJANGO_HSTS_SECONDS=31536000
DJANGO_ADMIN=0
DJANGO_MEDIA_ROOT=/var/lib/eduma/media
POSTGRES_DB=eduma
POSTGRES_USER=eduma
POSTGRES_PASSWORD=eduma
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
# The address of the Eduma main site. Each institution is served at <slug>.<this host>, e.g. aster.eduma.app.
EDUMA_BASE_URL=http://localhost:4201
# Where the "Talk to us" button on the Eduma landing page sends email.
EDUMA_CONTACT_EMAIL=hello@eduma.example
